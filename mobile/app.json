{
  "expo": {
    "name": "Circle",
    "slug": "circle",
    "scheme": "circle",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "ios": {
      "bundleIdentifier": "com.timwheeler.circle.mobile",
      "supportsTablet": false,
      "usesAppleSignIn": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.timwheeler.circle.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#1e1e1e",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "expo-apple-authentication",
      "expo-secure-store",
      "expo-sqlite",
      [
        "expo-notifications",
        {
          "sounds": []
        }
      ]
    ],
    "owner": "timwheeler",
    "extra": {
      "eas": {
        "projectId": "800addcd-b479-4e9e-942e-d6baa26041ac"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/800addcd-b479-4e9e-942e-d6baa26041ac"
    }
  }
}
