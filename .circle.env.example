# Copy to .circle.env and fill in. Read by scripts/*.command.
CF_ACCOUNT_EMAIL="you@example.com"          # Cloudflare account deploy.command must use
SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"   # optional; ad-hoc signing if empty
NOTARY_PROFILE="circle-notary"              # xcrun notarytool store-credentials <name>
